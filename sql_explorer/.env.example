# Copy to .env and fill in. .env is gitignored — never commit the key.

# Google AI Studio key for Gemini. The model is called directly, not through
# Vertex, so this is all the auth needed.
GOOGLE_API_KEY=

# Claude API key, from platform.claude.com (Console) — NOT a claude.ai Team/Pro
# login, which does not include API access. Only read when SQLX_MODEL is a
# claude-* model.
ANTHROPIC_API_KEY=

# Keys for the other providers (llm.py). Each is read only when SQLX_MODEL names
# that provider, so any number can stay filled in and switching is one line.
# OPENAI_API_KEY=        openai:gpt-6-astra
# OPENROUTER_API_KEY=    openrouter:qwen/qwen3.8-max   (one key, most models)
# DEEPSEEK_API_KEY=      deepseek:deepseek-flash
# DASHSCOPE_API_KEY=     qwen:qwen3.8-max
# MOONSHOT_API_KEY=      kimi:kimi-k3
# MISTRAL_API_KEY=       mistral:mistral-medium-latest
# TOGETHER_API_KEY=      together:<model id from their catalogue>
# GROQ_API_KEY=          groq:<model id>
# FIREWORKS_API_KEY=     fireworks:<model id>

# Defaults shown; override only if your setup differs.
SQLX_MCP_URL=http://127.0.0.1:8770/mcp
# A bare gemini-* or claude-* name (e.g. claude-sonnet-5-5), or provider:model
# for the rest -- see the keys above. Re-check the spend caps below after a
# switch: they count tokens, and a token does not cost the same everywhere.
SQLX_MODEL=gemini-4-argon

# Spend caps. See budget.py for what each one closes off.
SQLX_MAX_SESSION_QUESTIONS=12
SQLX_MAX_DAILY_TOKENS=2000000
SQLX_MAX_AGENT_STEPS=28

# Where the daily token ledger is written. Must be writable by the service user.
# On the box this is /var/lib/sql-explorer/budget.json.
# SQLX_STATE_PATH=
