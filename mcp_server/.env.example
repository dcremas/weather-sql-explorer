# Copy to .env and fill in. .env is gitignored — never commit the password.
#
# The password for the mcp_ro role created by setup_role.sql:
#   ALTER ROLE mcp_ro PASSWORD 'choose-something-long';
MCP_DB_PASSWORD=

# Defaults shown; override only if your tunnel differs.
MCP_DB_HOST=127.0.0.1
MCP_DB_PORT=15432
MCP_DB_USER=mcp_ro
